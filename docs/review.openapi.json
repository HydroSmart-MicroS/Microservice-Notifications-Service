{
  "openapi": "3.1.0",
  "info": {
    "title": "HydroSmart notifications review API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/notifications": {
      "get": {
        "summary": "List the current user's notifications",
        "description": "Representative operation. The example is synthetic and shows selected fields.",
        "responses": {
          "200": {
            "description": "Successful query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "unreadCount": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "items": [],
                  "nextCursor": null,
                  "unreadCount": 0
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "402": {
            "description": "An active plan is required by Gateway"
          }
        },
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
